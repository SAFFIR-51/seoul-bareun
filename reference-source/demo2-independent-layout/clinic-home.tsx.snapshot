"use client";

import Image from "next/image";
import { ArrowDown, ArrowLeft, ArrowRight, ArrowUpRight, Check, ChevronDown, Clock3, MapPin, Menu, Phone, X } from "lucide-react";
import { useEffect, useRef, useState, type KeyboardEvent, type ReactNode } from "react";
import { checkups, chronicCare, doctors, endoscopies, navigation, programs, questions, services, spaces, ultrasounds } from "./clinic-data";
import s from "./clinic-home.module.css";

const doctorKeys = doctors.map(item => item.key);
const checkupKeys = checkups.map(item => item.key);
const endoscopyKeys = endoscopies.map(item => item.key);
const spaceKeys = spaces.map(item => item.key);
const programKeys = ["basic-men", "advanced-men", "vip-men", "basic-women", "advanced-women", "vip-women"];

function useChoice(query: string, keys: string[]) {
  const [selected, setSelected] = useState(0);
  const panel = useRef<HTMLDivElement>(null);
  const shouldAnimate = useRef(false);
  useEffect(() => {
    const sync = () => {
      const value = new URLSearchParams(window.location.search).get(query);
      const index = value ? keys.indexOf(value) : 0;
      shouldAnimate.current = false;
      setSelected(index < 0 ? 0 : index);
    };
    sync(); window.addEventListener("popstate", sync);
    return () => window.removeEventListener("popstate", sync);
  }, [query, keys]);
  useEffect(() => {
    if (!shouldAnimate.current || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    shouldAnimate.current = false;
    const animation = panel.current?.animate([{ opacity: .55 }, { opacity: 1 }], { duration: 180, easing: "cubic-bezier(.23,1,.32,1)" });
    return () => animation?.cancel();
  }, [selected]);
  function select(index: number, animate = true) {
    shouldAnimate.current = animate;
    setSelected(index);
    const url = new URL(window.location.href);
    if (index === 0) url.searchParams.delete(query); else url.searchParams.set(query, keys[index]);
    window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
  }
  return { selected, select, panel };
}

function TabBar({ id, label, items, selected, onSelect, compact = false }: { id: string; label: string; items: string[]; selected: number; onSelect: (index: number, animate?: boolean) => void; compact?: boolean }) {
  function handleKey(event: KeyboardEvent<HTMLButtonElement>, index: number) {
    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
    event.preventDefault();
    const next = event.key === "Home" ? 0 : event.key === "End" ? items.length - 1 : (index + (event.key === "ArrowRight" ? 1 : items.length - 1)) % items.length;
    onSelect(next, false);
    event.currentTarget.parentElement?.querySelectorAll<HTMLButtonElement>("button")[next]?.focus({ preventScroll: true });
  }
  return <div className={`${s.tabs} ${compact ? s.compactTabs : ""}`} role="tablist" aria-label={label}>
    {items.map((item, index) => <button type="button" role="tab" id={`${id}-tab-${index}`} aria-controls={`${id}-panel-${index}`} aria-selected={index === selected} tabIndex={index === selected ? 0 : -1} key={item} onClick={event => onSelect(index, event.detail !== 0)} onKeyDown={event => handleKey(event, index)}>{item}</button>)}
  </div>;
}

function TabPanel({ id, index, selected, children }: { id: string; index: number; selected: number; children: ReactNode }) {
  return <div role="tabpanel" className={s.tabPanel} id={`${id}-panel-${index}`} aria-labelledby={`${id}-tab-${index}`} hidden={selected !== index} tabIndex={0}>{children}</div>;
}

function Photo({ name, alt, className = "", eager = false }: { name: string; alt: string; className?: string; eager?: boolean }) {
  return <div className={`${s.photo} ${className}`}><Image src={`/images/${name}.webp`} alt={`${alt} · AI 생성 데모 이미지`} fill sizes="(max-width: 760px) 100vw, (max-width: 1100px) 60vw, 50vw" className={s.photoImage} loading={eager ? "eager" : "lazy"} fetchPriority={eager ? "high" : "auto"} /></div>;
}

function Disclosure({ title, children, hint }: { title: string; children: ReactNode; hint?: string }) {
  return <details className={s.disclosure}><summary><span>{title}{hint && <small>{hint}</small>}</span><ChevronDown size={21} aria-hidden="true" /></summary><div className={s.disclosureContent}>{children}</div></details>;
}

export default function ClinicHome() {
  const doctor = useChoice("care", doctorKeys);
  const checkup = useChoice("checkup", checkupKeys);
  const endoscopy = useChoice("exam", endoscopyKeys);
  const program = useChoice("program", programKeys);
  const gallery = useChoice("space", spaceKeys);
  const menuRef = useRef<HTMLDialogElement>(null);
  const noticeRef = useRef<HTMLDialogElement>(null);
  const [menuOpen, setMenuOpen] = useState(false);
  const [notice, setNotice] = useState<"contact" | "fees" | "map" | null>(null);
  const [activeHash, setActiveHash] = useState("");
  const selectedDoctor = doctors[doctor.selected];
  const selectedSpace = spaces[gallery.selected];

  useEffect(() => {
    const update = () => setActiveHash(window.location.hash);
    update(); window.addEventListener("hashchange", update);
    return () => window.removeEventListener("hashchange", update);
  }, []);
  useEffect(() => {
    const dialog = noticeRef.current;
    if (notice && dialog && !dialog.open) dialog.showModal(); else if (!notice && dialog?.open) dialog.close();
  }, [notice]);
  useEffect(() => {
    if (!menuOpen && !notice) return;
    const previous = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => { document.body.style.overflow = previous; };
  }, [menuOpen, notice]);
  useEffect(() => {
    const media = window.matchMedia("(min-width: 1101px)");
    const update = () => { if (media.matches) menuRef.current?.close(); };
    media.addEventListener("change", update);
    return () => media.removeEventListener("change", update);
  }, []);
  function openMenu() { menuRef.current?.showModal(); setMenuOpen(true); }
  function closeMenu() { menuRef.current?.close(); setMenuOpen(false); }
  function galleryKey(event: KeyboardEvent<HTMLButtonElement>, index: number) {
    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
    event.preventDefault();
    const next = event.key === "Home" ? 0 : event.key === "End" ? spaces.length - 1 : (index + (event.key === "ArrowRight" ? 1 : spaces.length - 1)) % spaces.length;
    gallery.select(next, false);
    event.currentTarget.parentElement?.querySelectorAll<HTMLButtonElement>("button")[next]?.focus({ preventScroll: true });
  }

  return <div id="top" className={s.site} data-bareun-site onKeyDownCapture={event => { event.currentTarget.dataset.input = "keyboard"; }} onPointerDownCapture={event => { event.currentTarget.dataset.input = "pointer"; }}>
    <a className={s.skipLink} href="#main">본문 바로가기</a>
    <header className={s.header}>
      <div className={`${s.shell} ${s.headerInner}`}>
        <a href="#top" className={s.logo} aria-label="서울바른내과 처음으로"><Image src="/images/seoul-bareun-logo-hd.png" width={1935} height={486} sizes="240px" alt="서울바른내과" loading="eager" /></a>
        <nav className={s.desktopNav} aria-label="주요 메뉴">{navigation.map(item => <a key={item.href} href={item.href} aria-current={activeHash === item.href ? "location" : undefined}>{item.label}</a>)}</nav>
        <button type="button" className={`${s.button} ${s.headerContact}`} onClick={() => setNotice("contact")}><Phone size={17} aria-hidden="true" />상담 안내</button>
        <button type="button" className={s.menuButton} aria-label="메뉴 열기" aria-expanded={menuOpen} aria-controls="bareun-menu" onClick={openMenu}><Menu size={27} aria-hidden="true" /></button>
      </div>
    </header>

    <main id="main" tabIndex={-1}>
      <section className={s.hero} aria-labelledby="hero-title">
        <div className={`${s.shell} ${s.heroGrid}`}>
          <div className={s.heroCopy}>
            <h1 id="hero-title">충분히 듣고,<br /> 바르게 살핍니다.</h1>
            <p>건강검진부터 일상의 건강관리까지.<br />  당신의 이야기에 귀 기울이는 서울바른내과입니다.</p>
            <div className={s.heroActions}><a href="#checkup" className={s.button}>건강검진 알아보기<ArrowUpRight size={19} aria-hidden="true" /></a><a href="#doctors" className={s.textLink}>의료진 소개<ArrowRight size={19} aria-hidden="true" /></a></div>
            <a className={s.heroScroll} href="#care">서울바른내과 진료 안내<ArrowDown size={17} aria-hidden="true" /></a>
          </div>
          <figure className={s.heroFigure}><Photo name="consultation" alt="진료실에서 이야기를 나누는 의료진과 내원객" className={s.heroPhoto} eager /><figcaption>충분한 대화에서 시작하는 진료를 생각합니다.</figcaption></figure>
        </div>
      </section>

      <div className={`${s.shell} ${s.intentLinks}`} aria-label="방문 목적별 안내">
        <a href="#checkup"><span>검진을 알아보고 있어요</span><ArrowUpRight size={22} aria-hidden="true" /></a>
        <a href="#care"><span>진료과목이 궁금해요</span><ArrowUpRight size={22} aria-hidden="true" /></a>
        <a href="#visit"><span>처음 방문해요</span><ArrowUpRight size={22} aria-hidden="true" /></a>
      </div>

      <section id="care" className={`${s.section} ${s.shell}`} aria-labelledby="care-title">
        <div className={s.sectionHead}><h2 id="care-title">필요한 진료를<br /> 편하게 찾아보세요.</h2><p>검진과 검사, 일상의 건강관리.<br /> 궁금한 안내부터 차근차근 살펴보세요.</p></div>
        <div className={s.serviceGrid}>
          <a href="#checkup" className={s.featureService}><h3>건강검진센터</h3><p>지금 나에게 필요한 검진을<br /> 함께 알아보는 시간</p><span>검진 종류와 준비사항 보기<ArrowUpRight size={27} aria-hidden="true" /></span></a>
          <div className={s.serviceList}>{services.map(item => <a href={item.href} key={item.href}><div><h3>{item.title}</h3><p>{item.description}</p></div><ArrowUpRight size={24} aria-hidden="true" /></a>)}</div>
        </div>
      </section>

      <section id="doctors" className={`${s.section} ${s.softSection}`} aria-labelledby="doctors-title">
        <div className={s.shell}>
          <div className={s.sectionHead}><h2 id="doctors-title">진료의 시작은<br /> 이야기를 듣는 일입니다.</h2><p>건강에 대한 걱정과 궁금한 점을<br /> 편안하게 나눌 수 있도록.</p></div>
          <div className={s.doctorGrid}>
            <figure><Photo name={selectedDoctor.image} alt="의료진 소개용 인물" className={s.doctorPhoto} /><figcaption className={s.caption}>의료진 소개용 AI 이미지입니다. 실제 성함과 약력은 확인 후 안내됩니다.</figcaption></figure>
            <div className={s.doctorInfo}>
              <TabBar id="doctor" label="의료진 소개" items={doctors.map(item => item.tab)} selected={doctor.selected} onSelect={doctor.select} />
              <div ref={doctor.panel} className={s.doctorPanels}>{doctors.map((item, index) => <TabPanel id="doctor" index={index} selected={doctor.selected} key={item.key}><h3>{item.title.split("\n").map((line, i) => <span key={line}>{i > 0 && <br /> }{line}</span>)}</h3><p>{item.description}</p><ul className={s.checkList}>{item.points.map(point => <li key={point}><Check size={18} aria-hidden="true" /><span>{point}</span></li>)}</ul></TabPanel>)}</div>
              <a href="#visit" className={s.textLink}>방문 안내 확인하기<ArrowRight size={19} aria-hidden="true" /></a>
            </div>
          </div>
        </div>
      </section>

      <section id="checkup" className={`${s.section} ${s.shell}`} aria-labelledby="checkup-title">
        <div className={s.sectionHead}><h2 id="checkup-title">나에게 맞는 건강검진,<br /> 준비부터 결과 안내까지.</h2><p>검진을 선택하기 전에<br /> 목적과 과정을 먼저 확인하세요.</p></div>
        <TabBar id="checkup" label="건강검진 종류" items={checkups.map(item => item.label)} selected={checkup.selected} onSelect={checkup.select} />
        <div ref={checkup.panel} className={s.checkupPanels}>{checkups.map((item, index) => <TabPanel id="checkup" index={index} selected={checkup.selected} key={item.key}>
          <div className={s.checkupGrid}><div><h3>{item.title}</h3><p>{item.description}</p><ul className={s.checkList}>{item.points.map(point => <li key={point}><Check size={18} aria-hidden="true" /><span>{point}</span></li>)}</ul></div><aside className={s.prepareBox}><h4>상담 전에 준비해 주세요</h4><ul><li>이전에 받은 검사와 검진 결과</li><li>현재 복용 중인 약 목록</li><li>상담하고 싶은 건강 고민</li></ul><p>{item.note}</p></aside></div>
          {index === 0 && <details className={s.programDetails}><summary>종합검진 프로그램 구성 예시<ChevronDown size={20} aria-hidden="true" /></summary><TabBar id="program" label="종합검진 프로그램 예시" compact items={programs} selected={program.selected} onSelect={program.select} /><div ref={program.panel}>{programs.map((name, i) => <TabPanel id="program" index={i} selected={program.selected} key={name}><div className={s.programContent}><h4>{name}</h4><p>검진 상담 · 기초 상태 확인 · 검사 과정 안내 · 결과 상담</p><p className={s.caption}>페이지 구성을 위한 예시입니다. 실제 검진 항목과 비용은 개별 상담으로 확인해 주세요.</p></div></TabPanel>)}</div></details>}
        </TabPanel>)}</div>
        <ol className={s.processList}><li><h3>검진 전 상담</h3><p>건강 이력과 궁금한 점을<br /> 함께 확인합니다.</p></li><li><h3>검사 준비와 진행</h3><p>개인에게 필요한 준비사항과<br /> 진행 과정을 안내합니다.</p></li><li><h3>결과 안내와 상담</h3><p>검사 결과를 살펴보고<br /> 다음 관리를 함께 생각합니다.</p></li></ol>
      </section>

      <section id="endoscopy" className={`${s.section} ${s.endoscopySection}`} aria-labelledby="endoscopy-title">
        <div className={`${s.shell} ${s.splitGrid}`}><Photo name="endoscopy" alt="내시경 검사 공간" className={s.endoscopyPhoto} /><div className={s.splitCopy}><h2 id="endoscopy-title">소화기내시경클리닉</h2><p className={s.largeCopy}>검사에 대한 궁금함을<br /> 하나씩 확인해 보세요.</p><TabBar id="endoscopy" label="내시경 검사 종류" compact items={endoscopies.map(item => item.label)} selected={endoscopy.selected} onSelect={endoscopy.select} /><div ref={endoscopy.panel}>{endoscopies.map((item, index) => <TabPanel id="endoscopy" index={index} selected={endoscopy.selected} key={item.key}><h3 className={s.smallTitle}>{item.title}</h3><p>{item.text}</p></TabPanel>)}</div><Disclosure title="검사 준비 안내 보기">현재의 건강 상태와 복용 중인 약, 이전 검사 이력을 상담 시 알려 주세요. 식사와 약 복용을 포함한 구체적인 준비 및 회복 과정은 의료진의 개별 안내를 확인해 주세요.</Disclosure></div></div>
      </section>

      <section id="ultrasound" className={`${s.section} ${s.softSection}`} aria-labelledby="ultrasound-title"><div className={s.shell}>
        <div className={s.sectionHead}><h2 id="ultrasound-title">초음파 검사,<br /> 이해하기 쉬운 안내부터.</h2><p>검사 목적과 준비 과정에 대한 궁금함.<br /> 항목별 안내를 펼쳐 확인하세요.</p></div>
        <div className={s.ultrasoundList}>{ultrasounds.map(([title, text]) => <Disclosure title={title} key={title}>{text}</Disclosure>)}</div>
      </div></section>

      <section id="chronic" className={`${s.section} ${s.shell}`} aria-labelledby="chronic-title"><div className={s.chronicGrid}><div><h2 id="chronic-title">일상에서 이어지는<br /> 꾸준한 건강관리.</h2><p className={s.sectionIntro}>진료실을 나선 뒤의 생활까지 생각합니다.<br /> 몸의 변화와 생활습관을 함께 살펴보세요.</p><a href="#visit" className={s.textLink}>진료·방문 안내<ArrowRight size={19} aria-hidden="true" /></a></div><div>{chronicCare.map(([title, hint, text]) => <Disclosure title={title} hint={hint} key={title}>{text}</Disclosure>)}</div></div></section>

      <section id="philosophy" className={`${s.section} ${s.philosophy}`} aria-labelledby="philosophy-title"><div className={`${s.shell} ${s.philosophyGrid}`}><div><h2 id="philosophy-title">잘 듣고,<br /> 함께 생각합니다.</h2><p>진료실에서 나누는 대화가<br /> 건강한 일상의 시작이 되도록.</p></div><dl><div><dt>충분한 경청</dt><dd>작은 불편함과 건강에 대한 걱정에도<br /> 귀 기울이는 진료를 생각합니다.</dd></div><div><dt>이해하기 쉬운 설명</dt><dd>검사가 필요한 이유와 과정을<br /> 차근차근 안내하겠습니다.</dd></div><div><dt>일상 속 동행</dt><dd>개인별 건강 상태와 생활습관을<br /> 함께 살피며 관리 방향을 상담합니다.</dd></div></dl></div></section>

      <section id="wellness" className={`${s.section} ${s.shell}`} aria-labelledby="wellness-title"><div className={s.wellnessGrid}><div className={s.wellnessCopy}><h2 id="wellness-title">영양·웰빙클리닉</h2><p className={s.largeCopy}>나에게 집중하는<br /> 회복의 시간.</p><p>몸의 상태와 생활습관을 먼저 살피고,<br /> 개인에게 필요한 관리 방향을 상담합니다.</p><Disclosure title="수액 상담">현재의 건강 상태와 궁금한 사항을 먼저 상담해 주세요. 치료 여부와 구체적인 방법은 의료진의 개별 안내를 확인합니다.</Disclosure><Disclosure title="체중·생활습관 상담">생활습관과 일상 속 건강 고민을 함께 나누고, 개인의 상태에 맞는 관리 방향을 상담합니다.</Disclosure></div><Photo name="infusion" alt="차분한 회복 공간" className={s.wellnessPhoto} /></div></section>

      <section id="vaccination" className={`${s.section} ${s.softSection}`} aria-labelledby="vaccination-title"><div className={`${s.shell} ${s.vaccinationGrid}`}><div><h2 id="vaccination-title">예방접종,<br /> 내게 필요한 안내부터.</h2><p className={s.sectionIntro}>나이와 건강 상태, 이전 접종 이력에 따라<br /> 필요한 안내가 달라질 수 있습니다.</p><p className={s.caption}>접종 대상·일정·실제 접종 가능 여부는<br /> 의료진의 개별 안내를 확인해 주세요.</p></div><ul className={s.vaccineList}>{["독감(인플루엔자)", "폐렴구균", "대상포진", "HPV", "A형 간염", "B형 간염"].map(name => <li key={name}>{name}<span>개인별 접종 상담</span></li>)}</ul></div></section>

      <section id="equipment" className={`${s.section} ${s.shell}`} aria-labelledby="equipment-title"><div className={s.sectionHead}><h2 id="equipment-title">검사의 과정까지<br /> 생각한 공간.</h2><p>상담부터 검사와 회복까지.<br /> 각 공간에 담고자 하는 생각을 소개합니다.</p></div><div className={s.environmentGrid}>{[{ name: "endoscopy", title: "내시경 검사 공간", text: "검사 준비와 진행 과정을 생각한 환경" }, { name: "ultrasound", title: "초음파 검사 공간", text: "검사에 대한 설명을 함께 듣는 공간" }, { name: "consultation", title: "상담 공간", text: "편안하게 궁금한 점을 나누는 시간" }].map(item => <figure key={item.name}><Photo name={item.name} alt={item.title} /><figcaption><h3>{item.title}</h3><p>{item.text}</p></figcaption></figure>)}</div><p className={s.caption}>공간·장비 이미지는 AI로 생성한 데모이며, 실제 시설이나 장비 보유 현황을 나타내지 않습니다.</p></section>

      <section id="space" className={`${s.section} ${s.gallerySection}`} aria-labelledby="space-title"><div className={s.shell}><div className={s.sectionHead}><h2 id="space-title">편안한 머무름을<br /> 생각합니다.</h2><p>대기 공간부터 상담실과 회복 공간까지.<br /> 사진을 선택해 둘러보세요.</p></div><div className={s.gallery} role="region" aria-roledescription="캐러셀" aria-label="병원 공간 둘러보기"><div ref={gallery.panel}><Photo name={selectedSpace.key} alt={selectedSpace.name} className={s.galleryPhoto} /></div><div className={s.galleryCaption}><div aria-live="polite" aria-atomic="true"><h3>{selectedSpace.name}</h3><p>{selectedSpace.description}</p></div><div className={s.galleryControls}><span aria-hidden="true">{gallery.selected + 1} / {spaces.length}</span><button type="button" aria-label="이전 공간 보기" onClick={event => gallery.select((gallery.selected + spaces.length - 1) % spaces.length, event.detail !== 0)}><ArrowLeft size={22} aria-hidden="true" /></button><button type="button" aria-label="다음 공간 보기" onClick={event => gallery.select((gallery.selected + 1) % spaces.length, event.detail !== 0)}><ArrowRight size={22} aria-hidden="true" /></button></div></div><div className={s.thumbnails} aria-label="공간 사진 선택">{spaces.map((item, index) => <button type="button" key={item.key} aria-label={`${item.name} 보기`} aria-pressed={gallery.selected === index} onClick={event => gallery.select(index, event.detail !== 0)} onKeyDown={event => galleryKey(event, index)}><Image src={`/images/${item.key}.webp`} alt="" width={240} height={150} sizes="(max-width: 760px) 30vw, 16vw" /><span>{item.name}</span></button>)}</div><p className={s.caption}>모든 공간 사진은 홈페이지 데모를 위해 생성한 이미지입니다.</p></div></div></section>

      <section id="visit" className={`${s.section} ${s.shell}`} aria-labelledby="visit-title"><div className={s.sectionHead}><h2 id="visit-title">오시는 길과<br /> 진료시간을 확인하세요.</h2><p>방문 전 필요한 정보를<br /> 한곳에서 확인할 수 있도록.</p></div><div className={s.visitGrid}><div className={s.visitInfo}><h3><Clock3 size={23} aria-hidden="true" />진료시간 안내</h3><dl className={s.hours}><div><dt>평일</dt><dd>09:00 – 18:00</dd></div><div><dt>토요일</dt><dd>09:00 – 13:00</dd></div><div><dt>점심시간</dt><dd>13:00 – 14:00</dd></div></dl><p className={s.caption}>진료시간 예시입니다. 실제 운영시간과 휴진일은 확인 후 안내됩니다.</p><div className={s.contactBlock}><h3><Phone size={22} aria-hidden="true" />상담 및 방문 문의</h3><p>궁금한 진료와 검진 정보를 확인하세요.</p><button type="button" className={s.button} onClick={() => setNotice("contact")}>상담 채널 안내<ArrowUpRight size={19} aria-hidden="true" /></button></div></div><div><button type="button" className={s.mapButton} aria-label="서울바른내과 위치 안내 확인" onClick={() => setNotice("map")}><Image src="/reference-assets/demo-map.svg" alt="실제 위치가 연결되지 않은 예시 지도" width={1366} height={580} unoptimized /><span><MapPin size={20} aria-hidden="true" />위치 안내 확인<ArrowUpRight size={19} aria-hidden="true" /></span></button><div className={s.addressInfo}><h3>서울바른내과</h3><p>주소와 주차 안내는 실제 병원 정보 확인 후 연결됩니다.</p><a href="#questions" className={s.textLink}>처음 방문하는 분 안내<ArrowRight size={18} aria-hidden="true" /></a></div></div></div></section>

      <section id="questions" className={`${s.section} ${s.faqSection}`} aria-labelledby="questions-title"><div className={`${s.shell} ${s.faqGrid}`}><h2 id="questions-title">방문 전에<br /> 궁금한 이야기.</h2><div>{questions.map(([title, answer]) => <Disclosure title={title} key={title}>{answer}</Disclosure>)}</div></div></section>
    </main>

    <footer className={s.footer}><div className={s.shell}><div className={s.footerTop}><a href="#top" aria-label="서울바른내과 처음으로"><Image src="/images/seoul-bareun-logo-hd.png" width={1935} height={486} sizes="220px" alt="서울바른내과" className={s.footerLogo} /></a><nav aria-label="하단 메뉴"><a href="#care">진료 안내</a><a href="#visit">오시는 길</a><button type="button" onClick={() => setNotice("fees")}>비급여 안내</button></nav></div><p>서울바른내과 홈페이지 디자인 데모입니다. 인물·시설은 AI 생성 이미지이며, 실제 예약·전화·주소는 연결되지 않습니다.</p><small>© 2026 서울바른내과. Seoul Barun Medical Clinic.</small></div></footer>

    <div className={s.mobileActions} aria-label="빠른 방문 안내"><button type="button" onClick={() => setNotice("contact")}><Phone size={19} aria-hidden="true" />상담 안내</button><a href="#visit"><MapPin size={19} aria-hidden="true" />오시는 길</a></div>
    <a href="#top" className={s.backTop} aria-label="페이지 맨 위로">맨 위로<ArrowUpRight size={17} aria-hidden="true" /></a>

    <dialog className={s.mobileMenu} ref={menuRef} id="bareun-menu" aria-label="서울바른내과 메뉴" onClose={() => setMenuOpen(false)} onClick={event => { if (event.target === event.currentTarget) closeMenu(); }}><div className={s.menuBody}><div className={s.menuTop}><Image src="/images/seoul-bareun-logo-hd.png" width={1935} height={486} sizes="200px" alt="서울바른내과" /><button type="button" aria-label="메뉴 닫기" onClick={closeMenu}><X size={27} aria-hidden="true" /></button></div><nav aria-label="모바일 주요 메뉴">{navigation.map(item => <a href={item.href} key={item.href} onClick={closeMenu}>{item.label}<ArrowUpRight size={22} aria-hidden="true" /></a>)}</nav><button type="button" className={s.button} onClick={() => { closeMenu(); setNotice("contact"); }}>상담 안내<Phone size={18} aria-hidden="true" /></button></div></dialog>
    <dialog className={s.notice} ref={noticeRef} aria-labelledby="notice-title" aria-describedby="notice-copy" onClose={() => setNotice(null)} onClick={event => { if (event.target === event.currentTarget) setNotice(null); }}><div className={s.noticeBody}><button type="button" className={s.noticeClose} aria-label="안내 닫기" onClick={() => setNotice(null)}><X size={24} aria-hidden="true" /></button><h2 id="notice-title">{notice === "fees" ? "비급여 안내" : notice === "map" ? "위치 안내" : "상담 및 방문 안내"}</h2><p id="notice-copy">{notice === "fees" ? "실제 비급여 항목과 비용은 병원 운영 정보 확인 후 안내됩니다. 화면에 소개된 검진 프로그램은 구성을 위한 예시입니다." : notice === "map" ? "실제 병원 주소와 주차 정보는 확인 후 연결됩니다. 현재 지도는 화면 구성을 위한 예시입니다." : "서울바른내과 홈페이지 데모입니다. 실제 전화번호와 상담 채널은 병원 정보 확인 후 연결됩니다. 현재 화면에서는 예약이나 문의가 접수되지 않습니다."}</p><button type="button" className={s.button} onClick={() => setNotice(null)}>확인</button></div></dialog>
  </div>;
}

