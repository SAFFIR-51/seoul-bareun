.site {
  --blue: #086ca9;
  --ink: #1b3246;
  --muted: #536373;
  --soft: #f2f6f8;
  --ease: cubic-bezier(.23,1,.32,1);
  font-family: NotoSansWeb,Arial,sans-serif;
  color: var(--ink);
  font-size: 17px;
  line-height: 1.8;
  word-break: keep-all;
  overflow-wrap: anywhere;
  background: #fff
}
.site * {
  box-sizing: border-box
}
.site h1,.site h2,.site h3,.site h4,.site p,.site figure,.site ul,.site ol,.site dl,.site dd {
  margin: 0
}
.site a {
  color: inherit;
  text-decoration: none
}
.site button {
  font: inherit;
  cursor: pointer
}
.site button,.site a {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation
}
.site button {
  color: inherit
}
.site h1,.site h2,.site h3,.site h4 {
  font-weight: 700;
  text-wrap: balance
}
.site h2 {
  font-size: clamp(30px,3vw,43px);
  line-height: 1.45;
  letter-spacing: -1.6px
}
.site h3 {
  font-size: 24px;
  line-height: 1.5;
  letter-spacing: -.7px
}
.site p {
  color: var(--muted)
}
.site ul {
  list-style: none;
  padding: 0
}
.site svg {
  flex-shrink: 0
}
.site :where(a,button,summary,[tabindex]):focus-visible {
  outline: 3px solid var(--blue);
  outline-offset: 5px
}
.shell {
  width: calc(100% - 96px);
  max-width: 1344px;
  margin-inline: auto
}
.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff
}
.headerInner {
  min-height: 100px;
  display: flex;
  align-items: center;
  gap: 34px
}
.logo {
  display: block;
  flex-shrink: 0;
  width: 232px
}
.logo img {
  display: block;
  width: 100%;
  height: auto
}
.desktopNav {
  display: flex;
  gap: 30px;
  margin-left: auto;
  align-items: center
}
.desktopNav a {
  min-height: 48px;
  display: flex;
  align-items: center;
  font-size: 16px;
  font-weight: 500;
  position: relative
}
.desktopNav a[aria-current] {
  color: var(--blue)
}
.desktopNav a[aria-current]:after {
  content: "";
  height: 2px;
  background: var(--blue);
  position: absolute;
  bottom: 4px;
  left: 0;
  right: 0
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  min-height: 54px;
  padding: 13px 24px;
  background: var(--blue);
  color: #fff!important;
  border: 0;
  font-weight: 500;
  font-size: 16px;
  transition: background-color 160ms var(--ease),transform 160ms var(--ease)
}
.headerContact {
  min-height: 48px;
  padding: 10px 19px;
  gap: 9px
}
.menuButton {
  display: none;
  border: 0;
  background: transparent;
  min-width: 48px;
  min-height: 48px;
  align-items: center;
  justify-content: center
}
.skipLink {
  position: fixed;
  left: 24px;
  top: -100px;
  z-index: 100;
  padding: 12px 22px;
  background: var(--blue);
  color: #fff!important
}
.skipLink:focus {
  top: 12px
}
.hero {
  background: #f0f4f7;
  padding: 44px 0 54px
}
.heroGrid {
  display: grid;
  grid-template-columns: .87fr 1.13fr;
  gap: 56px;
  align-items: center
}
.heroCopy {
  padding: 30px 0
}
.heroCopy h1 {
  font-size: clamp(42px,4.3vw,64px);
  line-height: 1.35;
  letter-spacing: -2.8px
}
.heroCopy>p {
  font-size: 18px;
  line-height: 1.9;
  margin-top: 28px
}
.heroActions {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 36px;
  flex-wrap: wrap
}
.textLink {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  min-height: 44px;
  font-weight: 500;
  font-size: 16px
}
.heroScroll {
  display: inline-flex;
  gap: 25px;
  align-items: center;
  min-height: 44px;
  font-size: 14px;
  margin-top: 64px;
  color: var(--muted)!important
}
.heroFigure {
  min-width: 0
}
.photo {
  position: relative;
  overflow: hidden;
  background: #e6edf2;
  isolation: isolate
}
.photoImage {
  object-fit: cover
}
.heroPhoto {
  height: 550px
}
.heroPhoto img {
  object-position: 62% center
}
.heroFigure figcaption {
  font-size: 14px;
  color: var(--muted);
  margin-top: 13px
}
.intentLinks {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 52px;
  padding-block: 30px
}
.intentLinks a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 54px;
  font-weight: 500;
  font-size: 18px
}
.intentLinks a svg {
  color: var(--blue)
}
.section {
  padding-block: 112px
}
.sectionHead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 54px
}
.sectionHead>p {
  max-width: 420px;
  line-height: 1.9
}
.serviceGrid {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 64px
}
.featureService {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: var(--blue);
  color: #fff!important;
  padding: 46px 44px;
  min-height: 420px
}
.featureService h3 {
  font-size: 34px
}
.featureService p {
  color: #fff;
  opacity: .9;
  margin-top: 18px;
  font-size: 19px
}
.featureService>span {
  display: flex;
  justify-content: space-between;
  width: 100%;
  align-items: center;
  margin-top: auto;
  padding-top: 50px;
  gap: 20px;
  font-size: 16px
}
.serviceList {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px
}
.serviceList a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 72px
}
.serviceList h3 {
  font-size: 23px
}
.serviceList p {
  font-size: 16px;
  margin-top: 2px
}
.serviceList svg {
  color: var(--blue)
}
.softSection {
  background: var(--soft)
}
.doctorGrid {
  display: grid;
  grid-template-columns: .95fr 1fr;
  gap: 96px;
  align-items: center
}
.doctorGrid>figure {
  min-width: 0
}
.doctorPhoto {
  height: 570px
}
.doctorPhoto img {
  object-position: center 20%
}
.caption {
  font-size: 14px!important;
  line-height: 1.7;
  color: var(--muted);
  margin-top: 18px!important
}
.doctorInfo {
  min-width: 0
}
.tabs {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: stretch
}
.tabs button {
  border: 0;
  border-bottom: 2px solid transparent;
  background: transparent;
  padding: 12px 16px;
  min-height: 52px;
  font-size: 17px;
  font-weight: 500;
  color: var(--muted);
  transition: color 160ms var(--ease),border-color 160ms var(--ease),background-color 160ms var(--ease)
}
.tabs button[aria-selected=true] {
  border-color: var(--blue);
  color: var(--blue)
}
.compactTabs {
  gap: 4px
}
.compactTabs button {
  font-size: 16px;
  padding: 12px
}
.tabPanel[hidden] {
  display: none
}
.doctorPanels {
  margin-top: 36px;
  min-height: 300px
}
.doctorPanels h3 {
  font-size: 32px;
  line-height: 1.55;
  margin-bottom: 22px
}
.doctorPanels p {
  line-height: 1.9
}
.checkList {
  display: grid;
  gap: 14px;
  margin-top: 28px!important
}
.checkList li {
  display: flex;
  gap: 12px;
  align-items: flex-start
}
.checkList svg {
  margin-top: 7px;
  color: var(--blue)
}
.doctorInfo>.textLink {
  margin-top: 26px
}
.checkupPanels {
  padding-top: 40px
}
.checkupGrid {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 100px;
  min-height: 304px
}
.checkupGrid h3 {
  font-size: 29px;
  margin-bottom: 17px
}
.checkupGrid .checkList {
  font-size: 16px
}
.prepareBox {
  background: #edf4f9;
  padding: 32px 36px
}
.prepareBox h4 {
  font-size: 20px
}
.prepareBox ul {
  margin-top: 17px;
  display: grid;
  gap: 7px;
  font-size: 16px
}
.prepareBox p {
  font-size: 14px;
  line-height: 1.75;
  margin-top: 18px
}
.programDetails {
  margin-top: 36px;
  background: var(--soft);
  padding: 0 30px
}
.programDetails>summary {
  display: flex;
  gap: 24px;
  justify-content: space-between;
  align-items: center;
  min-height: 72px;
  font-weight: 500;
  cursor: pointer;
  list-style: none
}
.programDetails>summary::-webkit-details-marker {
  display: none
}
.programDetails>summary svg {
  transition: transform 180ms var(--ease)
}
.programDetails[open]>summary svg {
  transform: rotate(180deg)
}
.programDetails>.tabs {
  padding-top: 8px
}
.programContent {
  padding: 24px 4px 32px
}
.programContent h4 {
  font-size: 20px;
  margin-bottom: 12px
}
.programContent p {
  font-size: 16px
}
.processList {
  list-style: none;
  padding: 36px 0 0;
  margin-top: 56px!important;
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 48px
}
.processList li {
  padding: 25px 28px;
  background: var(--soft)
}
.processList h3 {
  font-size: 21px;
  margin-bottom: 12px
}
.processList p {
  font-size: 16px
}
.endoscopySection {
  background: #edf3f7
}
.splitGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center
}
.endoscopyPhoto {
  height: 560px
}
.splitCopy {
  min-width: 0
}
.splitCopy h2 {
  font-size: 34px
}
.largeCopy {
  font-size: 28px!important;
  line-height: 1.5!important;
  letter-spacing: -.8px;
  color: var(--ink)!important;
  margin-top: 18px!important;
  margin-bottom: 28px!important
}
.splitCopy .tabs {
  margin-bottom: 24px
}
.smallTitle {
  font-size: 22px!important;
  margin-bottom: 14px!important
}
.splitCopy .tabPanel {
  min-height: 168px
}
.disclosure {
  margin-top: 12px
}
.disclosure>summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  min-height: 70px;
  padding: 16px 0;
  cursor: pointer;
  list-style: none;
  font-weight: 500;
  font-size: 20px
}
.disclosure>summary::-webkit-details-marker {
  display: none
}
.disclosure>summary small {
  display: block;
  font-size: 15px;
  line-height: 1.6;
  color: var(--muted);
  font-weight: 400;
  margin-top: 6px
}
.disclosure>summary svg {
  color: var(--blue);
  transition: transform 180ms var(--ease)
}
.disclosure[open]>summary svg {
  transform: rotate(180deg)
}
.disclosureContent {
  padding: 0 32px 24px 0;
  font-size: 16px;
  color: var(--muted);
  line-height: 1.9
}
.ultrasoundList {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px 32px
}
.ultrasoundList .disclosure {
  background: #fff;
  padding-inline: 28px;
  margin-top: 0
}
.chronicGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px
}
.sectionIntro {
  margin-block: 24px 26px!important
}
.chronicGrid .disclosure:first-child {
  margin-top: 0
}
.chronicGrid .disclosure {
  background: var(--soft);
  padding-inline: 28px
}
.philosophy {
  background: #18384f;
  color: #fff
}
.philosophyGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px
}
.philosophy h2 {
  font-size: 48px
}
.philosophy p {
  color: #d2e0eb;
  margin-top: 28px
}
.philosophy dl {
  display: grid;
  gap: 34px
}
.philosophy dt {
  font-size: 24px;
  font-weight: 500;
  margin-bottom: 10px
}
.philosophy dd {
  color: #d2e0eb;
  font-size: 17px;
  line-height: 1.9
}
.wellnessGrid {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 100px;
  align-items: center
}
.wellnessCopy h2 {
  font-size: 34px
}
.wellnessCopy>p {
  margin-bottom: 28px
}
.wellnessPhoto {
  height: 580px
}
.wellnessCopy .disclosure>summary {
  font-size: 19px
}
.vaccinationGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
  align-items: center
}
.vaccineList {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px 42px
}
.vaccineList li {
  font-size: 22px;
  font-weight: 500
}
.vaccineList span {
  display: block;
  font-size: 15px;
  font-weight: 400;
  color: var(--muted);
  margin-top: 7px
}
.environmentGrid {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 32px;
  align-items: start
}
.environmentGrid .photo {
  height: 340px
}
.environmentGrid figure:first-child .photo {
  height: 420px
}
.environmentGrid figure:nth-child(3) {
  padding-top: 72px
}
.environmentGrid figcaption {
  margin-top: 24px
}
.environmentGrid h3 {
  font-size: 23px
}
.environmentGrid p {
  font-size: 16px;
  margin-top: 8px
}
.gallerySection {
  background: var(--soft)
}
.galleryPhoto {
  height: 590px
}
.galleryCaption {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  align-items: center;
  min-height: 118px;
  padding-block: 22px
}
.galleryCaption h3 {
  font-size: 25px
}
.galleryCaption p {
  font-size: 16px;
  margin-top: 7px
}
.galleryControls {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-shrink: 0
}
.galleryControls>span {
  font-size: 15px;
  margin-right: 16px;
  font-variant-numeric: tabular-nums;
  color: var(--muted)
}
.galleryControls button {
  width: 48px;
  height: 48px;
  border: 1px solid #9faeb9; /* taste-skill-ignore: visible boundary for the 48px gallery navigation buttons. */
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 160ms var(--ease),transform 160ms var(--ease)
}
.thumbnails {
  display: grid;
  grid-template-columns: repeat(6,1fr);
  gap: 16px;
  margin-top: 12px
}
.thumbnails button {
  border: 0;
  background: transparent;
  padding: 0 0 8px;
  text-align: left;
  font-size: 15px;
  opacity: .7;
  transition: opacity 160ms var(--ease)
}
.thumbnails button[aria-pressed=true] {
  opacity: 1;
  outline: 2px solid var(--blue);
  outline-offset: 4px
}
.thumbnails img {
  width: 100%;
  height: auto;
  aspect-ratio: 1.7;
  object-fit: cover;
  display: block;
  margin-bottom: 9px
}
.thumbnails span {
  padding-inline: 3px
}
.visitGrid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 88px
}
.visitInfo h3 {
  display: flex;
  gap: 13px;
  align-items: center;
  font-size: 23px
}
.visitInfo h3 svg {
  color: var(--blue)
}
.hours {
  margin-top: 28px!important;
  display: grid;
  gap: 12px;
  font-variant-numeric: tabular-nums
}
.hours>div {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  max-width: 385px
}
.hours dt {
  color: var(--muted)
}
.hours dd {
  font-size: 19px;
  font-weight: 500;
  white-space: nowrap
}
.visitInfo>.caption {
  max-width: 385px
}
.contactBlock {
  margin-top: 42px
}
.contactBlock p {
  margin: 16px 0 22px;
  font-size: 16px
}
.mapButton {
  display: block;
  background: var(--soft);
  border: 0;
  padding: 0;
  width: 100%;
  text-align: left
}
.mapButton>img {
  width: 100%;
  height: auto;
  aspect-ratio: 1.85;
  object-fit: cover;
  display: block
}
.mapButton>span {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 22px;
  background: #e6eff5;
  min-height: 58px;
  font-size: 16px;
  font-weight: 500
}
.mapButton>span svg:last-child {
  margin-left: auto
}
.addressInfo {
  padding-top: 26px
}
.addressInfo h3 {
  font-size: 22px
}
.addressInfo p {
  font-size: 16px;
  margin-top: 12px
}
.addressInfo>.textLink {
  margin-top: 15px
}
.faqSection {
  background: var(--soft)
}
.faqGrid {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 70px
}
.faqGrid .disclosure {
  padding: 5px 24px;
  background: #fff;
  margin-top: 16px
}
.faqGrid .disclosure:first-child {
  margin-top: 0
}
.faqGrid .disclosure>summary {
  font-size: 18px
}
.footer {
  background: #e9eff3;
  padding: 56px 0 42px
}
.footerTop {
  display: flex;
  justify-content: space-between;
  gap: 32px;
  align-items: center;
  margin-bottom: 30px
}
.footerLogo {
  width: 220px;
  height: auto;
  display: block
}
.footerTop nav {
  display: flex;
  gap: 28px;
  align-items: center;
  font-size: 15px
}
.footerTop nav a,.footerTop nav button {
  min-height: 44px;
  display: flex;
  align-items: center
}
.footerTop nav button {
  border: 0;
  background: transparent;
  padding: 0;
  font-size: 15px
}
.footer p {
  font-size: 14px;
  max-width: 860px
}
.footer small {
  display: block;
  color: var(--muted);
  font-size: 13px;
  margin-top: 17px
}
.mobileActions {
  display: none
}
.backTop {
  position: fixed;
  right: 22px;
  bottom: 26px;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 10px 15px;
  background: #fff;
  border: 1px solid #b8c8d3; /* taste-skill-ignore: separates a fixed navigation control from the moving page below. */
  font-size: 13px
}
.mobileMenu,.notice {
  border: 0;
  padding: 0;
  color: var(--ink);
  background: #fff;
  max-height: 90dvh;
  overflow: auto;
  overscroll-behavior: contain
}
.mobileMenu::backdrop,.notice::backdrop {
  background: #132d4380
}
.mobileMenu {
  position: fixed;
  inset: 0 0 auto auto;
  margin: 0;
  width: 100%;
  max-width: 500px
}
.mobileMenu[open] {
  animation: menuIn 220ms var(--ease)
}
.menuBody {
  padding: 26px 30px 38px
}
.menuTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 22px
}
.menuTop img {
  width: 200px;
  height: auto
}
.menuTop button,.noticeClose {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  width: 44px;
  height: 44px;
  flex-shrink: 0
}
.menuBody nav {
  display: grid;
  margin-bottom: 28px
}
.menuBody nav a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 67px;
  font-size: 22px
}
.menuBody nav a svg {
  color: var(--blue)
}
.menuBody>.button {
  width: 100%
}
.notice {
  position: fixed;
  inset: 0;
  margin: auto;
  width: calc(100% - 40px);
  max-width: 500px;
  box-shadow: 0 16px 64px #12344c26 /* taste-skill-ignore: native modal overlay, not a resting content surface. */
}
.notice[open] {
  animation: noticeIn 180ms var(--ease)
}
.noticeBody {
  padding: 50px 38px 36px;
  position: relative
}
.noticeBody h2 {
  font-size: 28px;
  letter-spacing: -1px;
  margin-bottom: 20px
}
.noticeBody p {
  font-size: 16px;
  line-height: 1.9
}
.noticeBody>.button {
  width: 100%;
  margin-top: 30px
}
.noticeClose {
  position: absolute;
  right: 10px;
  top: 10px
}
.site[data-input=keyboard] .tabs button,.site[data-input=keyboard] .thumbnails button {
  transition: none
}
@keyframes menuIn {
  from {
    opacity: 0;
    transform: translateY(-8px)
  }
  to {
    opacity: 1;
    transform: translateY(0)
  }
}
@keyframes noticeIn {
  from {
    opacity: 0;
    transform: translateY(5px)
  }
  to {
    opacity: 1;
    transform: translateY(0)
  }
}
@media(hover:hover) and (pointer:fine) {
  .button:hover {
    background: #065689
  }
  .desktopNav a:hover,.textLink:hover,.serviceList a:hover h3,.intentLinks a:hover {
    color: var(--blue)
  }
  .galleryControls button:hover {
    background: #e1eaf0
  }
  .thumbnails button:hover {
    opacity: 1
  }
  .disclosure summary:hover {
    color: var(--blue)
  }
}
.button:active,.galleryControls button:active {
  transform: scale(.98)
}
@media(max-width:1250px) {
  .desktopNav {
    gap: 19px
  }
  .headerInner {
    gap: 22px
  }
  .logo {
    width: 210px
  }
  .shell {
    width: calc(100% - 72px)
  }
  .heroGrid {
    gap: 36px
  }
  .heroPhoto {
    height: 510px
  }
  .heroCopy h1 {
    font-size: 51px
  }
  .heroActions {
    gap: 18px
  }
  .doctorGrid,.splitGrid,.wellnessGrid,.vaccinationGrid,.visitGrid {
    gap: 54px
  }
  .doctorPhoto {
    height: 540px
  }
  .checkupGrid {
    gap: 56px
  }
  .heroScroll {
    margin-top: 40px
  }
  .heroCopy>p {
    font-size: 17px
  }
}
@media(max-width:1100px) {
  .headerInner {
    min-height: 84px
  }
  .desktopNav,.headerContact {
    display: none
  }
  .menuButton {
    display: flex;
    margin-left: auto
  }
  .heroCopy h1 {
    font-size: 43px;
    letter-spacing: -2px
  }
  .heroGrid {
    grid-template-columns: .95fr 1.05fr;
    gap: 30px
  }
  .heroCopy>p {
    font-size: 16px
  }
  .heroActions {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
    margin-top: 26px
  }
  .heroPhoto {
    height: 480px
  }
  .heroScroll {
    margin-top: 22px;
    font-size: 13px
  }
  .section {
    padding-block: 88px
  }
  .sectionHead {
    gap: 30px;
    margin-bottom: 42px
  }
  .sectionHead>p {
    font-size: 16px
  }
  .serviceGrid {
    gap: 40px
  }
  .featureService {
    padding: 36px;
    min-height: 420px
  }
  .featureService h3 {
    font-size: 29px
  }
  .serviceList h3 {
    font-size: 21px
  }
  .serviceList p {
    font-size: 15px
  }
  .doctorGrid {
    gap: 42px
  }
  .doctorPhoto {
    height: 520px
  }
  .tabs {
    gap: 4px
  }
  .tabs button {
    padding-inline: 11px;
    font-size: 16px
  }
  .doctorPanels h3 {
    font-size: 28px
  }
  .doctorPanels {
    min-height: 330px
  }
  .splitGrid {
    gap: 38px
  }
  .splitCopy h2,.wellnessCopy h2 {
    font-size: 28px
  }
  .largeCopy {
    font-size: 25px!important
  }
  .endoscopyPhoto,.wellnessPhoto {
    height: 530px
  }
  .checkupGrid {
    gap: 40px
  }
  .prepareBox {
    padding: 28px
  }
  .checkupGrid h3 {
    font-size: 26px
  }
  .chronicGrid,.philosophyGrid {
    gap: 54px
  }
  .intentLinks {
    gap: 30px
  }
  .intentLinks a {
    font-size: 16px
  }
  .processList {
    gap: 20px
  }
  .processList li {
    padding: 24px 20px
  }
  .environmentGrid {
    gap: 22px
  }
  .environmentGrid .photo {
    height: 280px
  }
  .environmentGrid figure:first-child .photo {
    height: 350px
  }
  .environmentGrid h3 {
    font-size: 20px
  }
  .galleryPhoto {
    height: 500px
  }
  .visitGrid {
    gap: 42px
  }
  .galleryCaption p {
    max-width: 460px
  }
  .vaccineList {
    gap: 28px
  }
  .vaccineList li {
    font-size: 20px
  }
}
@media(max-width:760px) {
  .site {
    font-size: 16px;
    padding-bottom: calc(64px + env(safe-area-inset-bottom))
  }
  .shell {
    width: calc(100% - 40px)
  }
  .headerInner {
    min-height: 78px
  }
  .logo {
    width: 205px
  }
  .hero {
    padding: 26px 0 30px
  }
  .heroGrid {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: stretch
  }
  .heroCopy {
    padding: 16px 0 0
  }
  .heroCopy h1 {
    font-size: 43px;
    letter-spacing: -1.9px;
    line-height: 1.35
  }
  .heroCopy>p {
    font-size: 16px;
    margin-top: 22px;
    line-height: 1.85
  }
  .heroCopy>p br {
    display: none
  }
  .heroActions {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    margin-top: 26px
  }
  .heroActions>.button {
    font-size: 15px;
    padding-inline: 17px;
    min-height: 52px;
    gap: 14px
  }
  .heroActions>.textLink {
    font-size: 15px;
    gap: 9px
  }
  .heroScroll {
    display: none
  }
  .heroPhoto {
    height: auto;
    aspect-ratio: 1.22
  }
  .heroFigure figcaption {
    font-size: 12px;
    margin-top: 10px
  }
  .intentLinks {
    grid-template-columns: 1fr;
    gap: 0;
    padding-block: 18px
  }
  .intentLinks a {
    min-height: 58px;
    font-size: 17px
  }
  .section {
    padding-block: 68px
  }
  .site h2 {
    font-size: 31px;
    letter-spacing: -1.2px;
    line-height: 1.45
  }
  .sectionHead {
    display: block;
    margin-bottom: 34px
  }
  .sectionHead>p {
    margin-top: 20px;
    font-size: 16px
  }
  .serviceGrid {
    grid-template-columns: 1fr;
    gap: 25px
  }
  .featureService {
    min-height: 286px;
    padding: 30px
  }
  .featureService h3 {
    font-size: 29px
  }
  .featureService p {
    font-size: 18px;
    margin-top: 12px
  }
  .featureService>span {
    font-size: 15px;
    padding-top: 35px
  }
  .serviceList {
    gap: 16px
  }
  .serviceList a {
    min-height: 76px
  }
  .serviceList h3 {
    font-size: 21px
  }
  .serviceList p {
    font-size: 15px;
    max-width: 280px;
    margin-top: 7px
  }
  .doctorGrid {
    grid-template-columns: 1fr;
    gap: 30px
  }
  .doctorPhoto {
    height: auto;
    aspect-ratio: 1.05
  }
  .doctorPhoto img {
    object-position: center 22%
  }
  .caption {
    font-size: 13px!important;
    line-height: 1.7
  }
  .doctorGrid figcaption {
    margin-top: 12px!important
  }
  .tabs {
    gap: 0;
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr))
  }
  .tabs button {
    font-size: 15px;
    padding: 12px 5px;
    min-height: 52px
  }
  .doctorPanels {
    margin-top: 28px;
    min-height: 310px
  }
  .doctorPanels h3 {
    font-size: 28px;
    margin-bottom: 18px
  }
  .checkList {
    gap: 12px;
    margin-top: 23px!important
  }
  .doctorInfo>.textLink {
    margin-top: 16px
  }
  .checkupPanels {
    padding-top: 30px
  }
  .checkupGrid {
    grid-template-columns: 1fr;
    gap: 28px;
    min-height: 0
  }
  .checkupGrid h3 {
    font-size: 26px
  }
  .prepareBox {
    padding: 25px
  }
  .prepareBox h4 {
    font-size: 19px
  }
  .programDetails {
    margin-top: 26px;
    padding: 0 19px
  }
  .programDetails>summary {
    font-size: 15px;
    gap: 16px;
    min-height: 76px
  }
  .programDetails .tabs {
    grid-template-columns: repeat(2,minmax(0,1fr))
  }
  .programDetails .tabs button {
    font-size: 14px;
    padding-block: 12px
  }
  .programContent {
    padding: 22px 0 28px
  }
  .programContent p {
    font-size: 15px
  }
  .processList {
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 30px!important;
    padding: 0
  }
  .processList li {
    padding: 23px 25px
  }
  .processList h3 {
    font-size: 20px;
    margin-bottom: 8px
  }
  .processList p br {
    display: none
  }
  .splitGrid {
    grid-template-columns: 1fr;
    gap: 30px
  }
  .endoscopyPhoto {
    height: auto;
    aspect-ratio: 1.25
  }
  .splitCopy h2,.wellnessCopy h2 {
    font-size: 29px
  }
  .largeCopy {
    font-size: 25px!important;
    margin-top: 16px!important;
    margin-bottom: 25px!important
  }
  .splitCopy .tabPanel {
    min-height: 172px
  }
  .smallTitle {
    font-size: 21px!important
  }
  .disclosure>summary {
    min-height: 70px;
    font-size: 18px;
    gap: 20px
  }
  .disclosureContent {
    font-size: 16px;
    padding-right: 10px;
    padding-bottom: 23px
  }
  .ultrasoundList {
    grid-template-columns: 1fr;
    gap: 12px
  }
  .ultrasoundList .disclosure {
    padding-inline: 22px
  }
  .chronicGrid {
    grid-template-columns: 1fr;
    gap: 26px
  }
  .chronicGrid .disclosure {
    padding-inline: 22px
  }
  .sectionIntro {
    margin-block: 20px 22px!important
  }
  .philosophyGrid {
    grid-template-columns: 1fr;
    gap: 42px
  }
  .philosophy h2 {
    font-size: 39px
  }
  .philosophy p {
    margin-top: 24px
  }
  .philosophy dt {
    font-size: 22px;
    margin-bottom: 8px
  }
  .philosophy dd {
    font-size: 16px
  }
  .philosophy dl {
    gap: 30px
  }
  .wellnessGrid {
    grid-template-columns: 1fr;
    gap: 28px
  }
  .wellnessPhoto {
    height: auto;
    aspect-ratio: 1.15
  }
  .wellnessCopy>p br {
    display: none
  }
  .wellnessCopy .disclosure>summary {
    font-size: 18px
  }
  .vaccinationGrid {
    grid-template-columns: 1fr;
    gap: 34px
  }
  .vaccineList {
    gap: 26px 24px
  }
  .vaccineList li {
    font-size: 19px
  }
  .vaccineList span {
    font-size: 14px
  }
  .environmentGrid {
    grid-template-columns: 1fr;
    gap: 32px
  }
  .environmentGrid .photo,.environmentGrid figure:first-child .photo {
    height: auto;
    aspect-ratio: 1.3
  }
  .environmentGrid figure:nth-child(3) {
    padding-top: 0
  }
  .environmentGrid figcaption {
    margin-top: 18px
  }
  .environmentGrid h3 {
    font-size: 22px
  }
  .environmentGrid p {
    margin-top: 7px
  }
  .galleryPhoto {
    height: auto;
    aspect-ratio: 1.16
  }
  .galleryCaption {
    display: block;
    padding-block: 22px;
    min-height: 0
  }
  .galleryCaption h3 {
    font-size: 23px
  }
  .galleryCaption p {
    font-size: 15px;
    margin-top: 9px
  }
  .galleryControls {
    justify-content: flex-end;
    margin-top: 20px
  }
  .galleryControls>span {
    margin-right: auto
  }
  .thumbnails {
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 18px 14px;
    margin-top: 9px
  }
  .thumbnails button {
    font-size: 13px
  }
  .thumbnails img {
    aspect-ratio: 1.4;
    margin-bottom: 7px
  }
  .visitGrid {
    grid-template-columns: 1fr;
    gap: 38px
  }
  .visitInfo h3 {
    font-size: 22px
  }
  .hours {
    margin-top: 24px!important;
    gap: 13px
  }
  .hours dd {
    font-size: 19px
  }
  .contactBlock {
    margin-top: 32px
  }
  .mapButton>img {
    aspect-ratio: 1.45
  }
  .addressInfo {
    padding-top: 23px
  }
  .faqGrid {
    grid-template-columns: 1fr;
    gap: 30px
  }
  .faqGrid .disclosure {
    padding-inline: 20px;
    margin-top: 12px
  }
  .faqGrid .disclosure>summary {
    font-size: 16px;
    min-height: 80px
  }
  .footer {
    padding: 42px 0 32px
  }
  .footerTop {
    display: block;
    margin-bottom: 23px
  }
  .footerLogo {
    width: 210px
  }
  .footerTop nav {
    gap: 24px;
    margin-top: 24px
  }
  .footer p {
    font-size: 13px;
    line-height: 1.8
  }
  .footer small {
    font-size: 12px
  }
  .mobileActions {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 55;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #fff;
    border-top: 1px solid #cbd7df; /* taste-skill-ignore: fixed mobile toolbar boundary keeps controls distinct from scrolling content. */
    padding: 6px 15px calc(6px + env(safe-area-inset-bottom))
  }
  .mobileActions button,.mobileActions a {
    display: flex;
    gap: 11px;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: 0;
    min-height: 50px;
    font-size: 16px;
    font-weight: 500
  }
  .mobileActions button {
    color: var(--blue)
  }
  .backTop {
    display: none
  }
  .noticeBody {
    padding: 48px 25px 28px
  }
  .noticeBody h2 {
    font-size: 25px
  }
  .menuBody {
    padding: 22px 24px 32px
  }
  .menuTop img {
    width: 190px
  }
  .section:has(>.tabs)>.tabs {
    grid-template-columns: repeat(2,minmax(0,1fr))
  }
}
@media(min-width:761px) {
  .checkupPanels {
    min-height: 400px
  }
}
@media(max-width:360px) {
  .heroCopy h1 {
    font-size: 37px
  }
  .logo {
    width: 185px
  }
  .heroActions {
    gap: 12px
  }
  .heroActions>.button {
    padding-inline: 14px
  }
  .heroActions>.textLink {
    font-size: 14px;
    gap: 5px
  }
  .site h2 {
    font-size: 28px
  }
  .featureService {
    padding: 26px
  }
  .tabs button {
    font-size: 14px
  }
  .menuTop img {
    width: 170px
  }
  .vaccineList li {
    font-size: 17px
  }
}
@media(prefers-reduced-motion:reduce) {
  .site *,.site *::before,.site *::after {
    animation: none!important;
    transition: none!important
  }
  .button:active,.galleryControls button:active {
    transform: none
  }
}
.footerLogo {
  mix-blend-mode: multiply
}
